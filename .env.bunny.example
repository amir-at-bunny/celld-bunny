# Copy to .env.bunny and fill in. Used by `npm run deploy`, `npm run node` and `npm run cells`.
# Get the S3 keys with: bunny storage zones credentials celld-bunny --connection s3 --show-secret
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=de
S3_ENDPOINT=https://de-s3.storage.bunnycdn.com
CELLD_BUCKET=s3://celld-bunny/fleet
